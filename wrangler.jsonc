{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "cloudflare/worker.ts",
	"name": "jbbru",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// The site's domains (Phase 7b): Cloudflare creates their DNS records and certificates on deploy.
	// www answers with a 308 to https://jbbru.com (cloudflare/worker.ts).
	// workers.dev stays on (a fallback address for testing and rollback); no per-version preview URLs.
	"workers_dev": true,
	"preview_urls": false,
	"routes": [
		{ "pattern": "jbbru.com", "custom_domain": true },
		{ "pattern": "www.jbbru.com", "custom_domain": true }
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		// The scene videos go through cloudflare/worker.ts so Range requests get 206 (Safari needs it), and
		// the passenger counter's route runs there too.
		"run_worker_first": ["/scene/clouds-v2/*", "/api/passenger"]
	},
	// The passenger counter (Phase 5d): one Durable Object with SQLite storage, the backend the Workers Free
	// plan offers. The class is exported from cloudflare/worker.ts.
	"durable_objects": {
		"bindings": [{ "name": "PASSENGER_COUNTER", "class_name": "PassengerCounter" }]
	},
	"exports": {
		"PassengerCounter": { "type": "durable-object", "storage": "sqlite" }
	},
	// A few counter calls per client a minute (the key is a hash of the address, never the address).
	"ratelimits": [
		{ "name": "PASSENGER_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "jbbru"
		}
	],
	"observability": {
		"enabled": true
	}
	// Not enabled yet: an R2 incremental cache (needs a bucket created on the account)
	// and the IMAGES binding for next/image (Cloudflare Images). Add them when the
	// app needs ISR or image optimisation. See https://opennext.js.org/cloudflare/caching
	// and https://opennext.js.org/cloudflare/howtos/image
}
