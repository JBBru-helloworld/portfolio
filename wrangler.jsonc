{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "cloudflare/worker.ts",
	"name": "jbbru",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		// The scene videos go through cloudflare/worker.ts so Range requests get 206 (Safari needs it).
		"run_worker_first": ["/scene/clouds-v2/*"]
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "jbbru"
		}
	],
	"observability": {
		"enabled": true
	}
	// Not enabled yet: an R2 incremental cache (needs a bucket created on the account)
	// and the IMAGES binding for next/image (Cloudflare Images). Add them when the
	// app needs ISR or image optimisation. See https://opennext.js.org/cloudflare/caching
	// and https://opennext.js.org/cloudflare/howtos/image
}
